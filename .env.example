# Copy to .env and source it, or export these directly.

# Master key used to derive per-device HMAC keys and validator keys.
# In production each device key must be provisioned in secure storage (NVS / HSM).
VCHAIN_MASTER_SECRET=change-me-before-any-real-deployment

VCHAIN_DB_PATH=.data/vchain.db
VCHAIN_MQTT_HOST=127.0.0.1
VCHAIN_MQTT_PORT=1883
VCHAIN_API_PORT=12000

VCHAIN_BLOCK_SIZE=8
VCHAIN_BLOCK_INTERVAL_S=1
VCHAIN_DIFFICULTY=4
VCHAIN_SEED_DEMO=1
VCHAIN_START_NODES=1
VCHAIN_LOG_LEVEL=INFO
